# Server
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=seu_secret_super_seguro_aqui

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_service_key_aqui

# APIs de Vagas
JOOBLE_API_KEY=sua_chave_jooble_aqui
ADZUNA_APP_ID=seu_app_id
ADZUNA_API_KEY=sua_chave_adzuna

# IA - Escolha UMA das opções abaixo:
# Opção 1: OpenRouter (RECOMENDADO - tem modelos GRATUITOS como mistral-7b)
# Cadastro gratuito em: openrouter.ai
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=mistralai/mistral-7b-instruct:free

# Opção 2: OpenAI (pago, mas muito barato com gpt-4o-mini)
# OPENAI_API_KEY=sk-...

# Opção 3: Anthropic Claude (pago)
# ANTHROPIC_API_KEY=sk-ant-...

# URL do seu site (usado pelo OpenRouter)
SITE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
